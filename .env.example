# MANIFEST environment template
# Copy to .env and fill in local values if needed

APP_ENV=development
USE_LLM=false
FUZZY_THRESHOLD=0.90
API_BASE_URL=http://localhost:8000

# Optional. Without either key, use_llm=true still works -- it falls back to
# the deterministic NullAdapter (llm/adapter.py) rather than failing. Read
# only by backend/ (core/ never reads env vars for secrets, per CLAUDE.md
# rule 2). Checked in order: ANTHROPIC_API_KEY first, then NVIDIA_API_KEY
# (a DeepSeek model via NVIDIA's NIM endpoint, https://build.nvidia.com --
# correct but noticeably slower per call, 10-35s observed, than Anthropic).
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# backend/config.py settings for the FastAPI service (app/streamlit_app.py
# never goes through HTTP, so none of these affect the Streamlit demo).
# Fail-closed: an unset MANIFEST_API_KEYS denies every request to every
# endpoint except /healthz, rather than leaving the API open by default.
MANIFEST_API_KEYS=dev-local-key-change-me
MANIFEST_CORS_ORIGINS=http://localhost:8501
MANIFEST_LOG_LEVEL=INFO
MANIFEST_LOG_JSON=true
