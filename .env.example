# MANIFEST environment template
# Copy to .env and fill in local values if needed

APP_ENV=development
USE_LLM=false
FUZZY_THRESHOLD=0.90
API_BASE_URL=http://localhost:8000

# Optional. Without it, use_llm=true still works -- it falls back to the
# deterministic NullAdapter (llm/adapter.py) rather than failing. Read only
# by backend/ (core/ never reads env vars for secrets, per CLAUDE.md rule 2).
ANTHROPIC_API_KEY=
